#!/usr/bin/env bun
import { hostname as osHostname } from "node:os"
import { parseArgs } from "node:util"
import { startServer } from "../src/server/server"
import { classifyAddresses, isLoopback, type AddressKind, type LocalAddress } from "../src/server/access"

try {
  const { values } = parseArgs({
    args: Bun.argv.slice(2),
    options: {
      port: { type: "string", short: "p" },
      hostname: { type: "string" },
      lan: { type: "boolean" },
      "allow-host": { type: "string", multiple: true },
      origin: { type: "string" },
      "browser-bin": { type: "string" },
      "no-browser": { type: "boolean" },
      server: { type: "string" },
      password: { type: "string" },
      username: { type: "string" },
      demo: { type: "boolean" },
      dev: { type: "boolean" },
      open: { type: "boolean" },
      "no-autostart": { type: "boolean" },
      help: { type: "boolean", short: "h" },
    },
    strict: true,
  })

  if (values.help) {
    console.log(`opencode-canvas: every OpenCode v2 session on one infinite canvas

Usage: opencode-canvas [options]

  -p, --port <n>        Port to listen on (default 4317, 0 = random)
      --hostname <h>    Interface to bind (default 127.0.0.1)
      --lan             Bind to 0.0.0.0 for LAN access (requires CANVAS_PASSWORD)
      --allow-host <h>  Allow a custom LAN hostname; repeat for multiple hosts
      --origin <url>    Exact public origin for a trusted HTTPS reverse proxy
      --browser-bin <p> Chrome/Chromium executable (or CANVAS_BROWSER_BIN)
      --no-browser      Disable the integrated browser
      --server <url>    OpenCode server URL (default: the background service)
      --password <pw>   Server password (default: OPENCODE_SERVER_PASSWORD or service.json)
      --username <u>    Server username (default: opencode)
      --demo            Run with simulated sessions, no OpenCode needed
      --open            Open the canvas in your browser
      --no-autostart    Don't start the OpenCode background service if it's stopped
      --dev             Hot reload the UI while editing
  -h, --help            Show this help`)
    process.exit(0)
  }

  const rawHostname = values.hostname ?? (values.lan ? "0.0.0.0" : "127.0.0.1")
  const hostname = rawHostname.startsWith("[") && rawHostname.endsWith("]") ? rawHostname.slice(1, -1) : rawHostname
  const portArg = values.port !== undefined ? values.port : (process.env.PORT || "4317")
  const portText = portArg.trim()
  const port = /^\d+$/.test(portText) ? Number(portText) : Number.NaN
  if (!Number.isInteger(port) || port < 0 || port > 65535) throw new Error("Port must be an integer from 0 to 65535.")
  const { server, upstream, upstreamError, stop } = await startServer({
    port,
    hostname,
    allowedHosts: values["allow-host"],
    publicOrigin: values.origin,
    browserBin: values["browser-bin"],
    browser: !values["no-browser"],
    server: values.server,
    password: values.password,
    username: values.username,
    demo: !!values.demo,
    dev: !!values.dev,
    autostart: !values["no-autostart"],
  })
  const localHost = hostname === "0.0.0.0" ? "127.0.0.1" : hostname === "::" ? "::1" : hostname
  const url = `http://${localHost.includes(":") ? `[${localHost}]` : localHost}:${server.port}`
  const up = upstream()
  console.log(`\x1b[1mopencode-canvas\x1b[0m  ${url}`)
  if (!isLoopback(hostname)) {
    const ipv6 = hostname.includes(":")
    const addresses = classifyAddresses().filter((entry) => entry.address.includes(":") === ipv6)
    const target = (entry: LocalAddress) => `http://${entry.address.includes(":") ? `[${entry.address}]` : entry.address}:${server.port}`
    const labels: Record<AddressKind, string> = { lan: "network ", vpn: "vpn     ", virtual: "virtual " }
    for (const kind of ["lan", "vpn", "virtual"] as const) {
      addresses.filter((entry) => entry.kind === kind).forEach((entry, i) => {
        console.log(`  ${i === 0 ? labels[kind] : "        "}${target(entry)}${kind === "lan" ? "" : `  (${entry.adapter})`}`)
      })
    }
    if (!addresses.some((entry) => entry.kind === "lan")) {
      console.log("  \x1b[33mwarning\x1b[0m   no physical LAN address found — another PC may not reach this host")
    }
    console.log(`  name      http://${osHostname()}:${server.port}`)
    console.log("  access    Canvas password required. Sign in from the other PC. Use a trusted LAN or HTTPS/VPN, not the public internet.")
  }
  if (values.demo) console.log("  mode      simulated sessions (demo)")
  else if (up) console.log(`  opencode  ${up.url}${up.password ? "  (authenticated)" : ""}`)
  else console.log(`  opencode  \x1b[31munavailable\x1b[0m  ${upstreamError() ?? ""}`)
  if (values.open) {
    const openTarget = values.origin ?? url
    const [openCmd, openArgs] =
      process.platform === "darwin"
        ? ["open", [openTarget]]
        : process.platform === "win32"
          ? ["cmd", ["/c", "start", "", openTarget]]
          : ["xdg-open", [openTarget]]
    try {
      Bun.spawn([openCmd, ...openArgs], { stdio: ["ignore", "ignore", "ignore"] }).unref()
    } catch (e) {
      console.error(`opencode-canvas: could not open a browser (${(e as Error).message}) — open ${openTarget} manually`)
    }
  }
  let shuttingDown = false
  const shutdown = async () => {
    if (shuttingDown) return
    shuttingDown = true
    await stop()
    process.exit(0)
  }
  process.once("SIGINT", shutdown)
  process.once("SIGTERM", shutdown)
} catch (e) {
  const msg = (e as Error).message
  console.error(`opencode-canvas: ${msg}`)
  if (/in use|EADDRINUSE/i.test(msg)) {
    const stopHint = process.platform === "win32"
      ? "stop the earlier process"
      : "stop it with `pkill -f opencode-canvas`"
    console.error(`  Another copy is probably running: open it, ${stopHint}, or pass --port <n>.`)
  }
  process.exit(1)
}
